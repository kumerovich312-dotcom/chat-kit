{
  "name": "@muras/chat-kit",
  "version": "0.1.0",
  "description": "Нейтральная основа переписки с клиентами: окно переписки (React), ядро без базы, подключения каналов",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/core/index.d.ts",
      "default": "./dist/core/index.js"
    },
    "./ui": {
      "types": "./dist/ui/index.d.ts",
      "default": "./dist/ui/index.js"
    },
    "./server": {
      "types": "./dist/server/index.d.ts",
      "default": "./dist/server/index.js"
    },
    "./nextbot": {
      "types": "./dist/channels/nextbot/index.d.ts",
      "default": "./dist/channels/nextbot/index.js"
    },
    "./studio": {
      "types": "./dist/channels/studio/index.d.ts",
      "default": "./dist/channels/studio/index.js"
    },
    "./styles.css": "./dist/ui/styles.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "demo": "vite --config demo/vite.config.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build": "node scripts/build.mjs",
    "check": "npm run typecheck && npm test && npm run build",
    "prepack": "node scripts/build.mjs",
    "release": "node scripts/release.mjs"
  },
  "peerDependencies": {
    "react": ">=19",
    "react-dom": ">=19"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.20.4",
    "@types/react": "~19.0.0",
    "@types/react-dom": "~19.0.0",
    "@vitejs/plugin-react": "^6.1.1",
    "jsdom": "^30.1.1",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "typescript": "~5.9",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  }
}
